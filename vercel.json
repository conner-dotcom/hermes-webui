{
  "version": 2,
  "framework": null,
  "buildCommand": "echo 'static site — no build'",
  "outputDirectory": "static",
  "installCommand": "echo 'no install needed'",
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/proxy?path=$1" },
    { "handle": "filesystem" },
    { "src": "/login", "dest": "https://dias-mac-studio.tail4f36cb.ts.net/hermes-webui/login" },
    { "src": "/static/(.*)", "dest": "/$1" },
    { "src": "/(.*)", "dest": "/index-vercel.html" }
  ]
}
